10 REM 32K RAM PACK: BIG ARRAYS ABOVE 8000H
20 DIM A(5000)
30 DIM B$(40,100)
40 FOR I=1 TO 5000
50 LET A(I)=I*3
60 NEXT I
70 LET B$(40)="LAST STRING"
80 LET S=0
90 FOR I=4991 TO 5000
100 LET S=S+A(I)
110 NEXT I
120 PRINT "SUM=";S;" ";B$(40)( TO 11)
130 PRINT "VARIABLES ABOVE 32K OK"
140 PRINT SIN (A(2)/6)
