# Full floating point test: arrays, FOR with fractional and negative steps, RND after RAND 1 (the ZX81's own sequence), GOSUB
# run_tests.sh compares the compiled program with the ROM's own BASIC interpreter
10 CLS
20 DIM A(5)
30 DIM B(3,4)
40 FOR I=1 TO 5
50 LET A(I)=I/4
60 NEXT I
70 FOR I=1 TO 5
80 PRINT A(I);" ";
90 NEXT I
100 PRINT
110 FOR I=1 TO 3
120 FOR J=1 TO 4
130 LET B(I,J)=I*10+J/10
140 NEXT J
150 NEXT I
160 PRINT B(2,3);" ";B(3,4);" ";B(1,1)
170 FOR X=1 TO 0 STEP -0.25
180 PRINT X;" ";
190 NEXT X
200 PRINT
205 LET N=0
210 FOR X=0 TO 1 STEP 0.1
220 LET N=N+1
230 NEXT X
240 PRINT N;" ";X
250 FOR K=5 TO 1
260 PRINT "NEVER"
270 NEXT K
280 PRINT K
290 LET S=0
300 FOR I=1 TO 100
310 LET S=S+1/I
320 NEXT I
330 PRINT S
340 RAND 1
350 PRINT RND;" ";RND
360 PRINT INT (RND*6)+1;" ";RND*6
370 GOSUB 400.4
380 PRINT "BACK"
390 GOTO 450
400 PRINT "SUB ";2.5*2
410 RETURN
450 PRINT "END ";A(2.6);" ";B(1.5,2.4)
460 LET A$="HELLO"
470 PRINT A$(1.6 TO 3.4);" ";A$ AND 0.5;"/";A$ AND 0
