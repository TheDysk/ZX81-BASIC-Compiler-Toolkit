10 PRINT "NAME?"
20 INPUT N$
30 PRINT "HI ";N$
40 PRINT "NUMBER?"
50 INPUT A
60 PRINT A;"*2=";A*2
70 PAUSE 4E4
80 PRINT "KEY ";INKEY$
90 FOR X=0 TO 63
100 PLOT X,0
110 PLOT X,43
120 NEXT X
130 PLOT 10,10
140 PLOT 11,10
150 PLOT 10,11
160 PLOT 11,11
170 UNPLOT 11,11
180 IF INKEY$<>"Q" THEN GOTO 180
190 PRINT AT 10,0;"GOT Q"
200 FOR I=1 TO 30
210 SCROLL
220 PRINT "S";I
230 NEXT I
240 GOTO 240
